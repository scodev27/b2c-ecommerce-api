{% extends 'base.html.twig' %}

{% block title %}Terra a Casa - Productes Ecològics{% endblock %}

{% block body %}
    <nav class="navbar navbar-expand-lg navbar-dark bg-success mb-4 shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">🌱 Terra a Casa</a>
            <div class="d-flex align-items-center">
                <a href="{{ path('app_cart') }}" class="btn btn-warning fw-bold me-3">🛒 La meva cistella</a>

                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_admin') }}" class="btn btn-outline-light me-2">Panell Admin</a>
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-light">Sortir</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-outline-light">Login Admin</a>
                {% endif %}
            </div>
        </div>
    </nav>

    <div class="container mt-3">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show text-center fw-bold">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    </div>

    <div class="container">
        <div class="text-center mb-5 mt-4">
            <h1 class="display-4 fw-bold">Benvinguts a Terra a Casa</h1>
            <p class="lead">Verdures ecològiques directes del camp a la teva taula.</p>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4 mb-5">
            {% for product in products %}
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="{{ asset('images/' ~ product.image) }}" class="card-img-top rounded" alt="{{ product.name }}" style="height: 200px; object-fit: cover;">

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">{{ product.name }}</h5>
                            <p class="card-text">{{ product.description }}</p>

                            <h3 class="mt-auto text-success fw-bold">{{ (product.price / 100)|number_format(2, ',', '.') }} €</h3>
                            <p class="text-muted small">Stock disponible: {{ product.stock }} unitats</p>

                            <a href="{{ path('cart_add', {'id': product.id}) }}" class="btn btn-success w-100 mt-2">Afegir a la cistella 🛒</a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center">
                    <p>No hi ha productes disponibles en aquest moment.</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
