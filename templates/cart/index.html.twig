{% extends 'base.html.twig' %}

{% block title %}La meva cistella - Terra a Casa{% endblock %}

{% block body %}
    <nav class="navbar navbar-dark bg-success mb-4 shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">🌱 Terra a Casa</a>
        </div>
    </nav>

    <div class="container mt-5">
        <h1 class="mb-4">🛒 La meva cistella</h1>

        {% if items|length > 0 %}
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                        <tr>
                            <th>Producte</th>
                            <th>Preu Unitari</th>
                            <th>Quantitat</th>
                            <th>Subtotal</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for item in items %}
                            <tr>
                                <td>
                                    <strong>{{ item.product.name }}</strong><br>
                                    <small class="text-muted">Stock disponible: {{ item.product.stock }}</small>
                                </td>
                                <td>{{ (item.product.price / 100)|number_format(2, ',', '.') }} €</td>
                                <td>{{ item.quantity }}</td>
                                <td><strong>{{ ((item.product.price * item.quantity) / 100)|number_format(2, ',', '.') }} €</strong></td>
                                <td class="text-end">
                                    <a href="{{ path('cart_remove', {'id': item.product.id}) }}" class="btn btn-sm btn-danger">🗑️ Treure</a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                        <tfoot class="table-group-divider">
                        <tr>
                            <td colspan="3" class="text-end h4 mb-0">Total a pagar:</td>
                            <td colspan="2" class="h3 text-success fw-bold mb-0">{{ (total / 100)|number_format(2, ',', '.') }} €</td>
                        </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="d-flex justify-content-between mb-5">
                <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">← Seguir comprant</a>
                <button class="btn btn-success btn-lg fw-bold">Tramitar Comanda →</button>
            </div>
        {% else %}
            <div class="alert alert-info text-center py-5">
                <h4 class="alert-heading">La teva cistella està buida! 🥬</h4>
                <p>Encara no has afegit cap capsa de verdures fresca.</p>
                <a href="{{ path('app_home') }}" class="btn btn-success mt-3">Anar a veure els productes</a>
            </div>
        {% endif %}
    </div>
{% endblock %}
